/* 全局主题变量与基础控件样式 */
page {
  background: #faf8ef;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei',
    'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  -webkit-tap-highlight-color: transparent;
}

/* ---------- 浅色 ---------- */
.theme-light {
  --bg: #faf8ef;
  --text: #3b3229;
  --text-muted: #8c7f6d;
  --board-bg: #bbada0;
  --cell-bg: rgba(238, 228, 218, 0.35);
  --panel-bg: #f3ece1;
  --panel-border: rgba(143, 122, 102, 0.22);
  --primary: #8f7a66;
  --primary-fg: #fdfbf7;
  --danger: #c0503b;
  --accent-soft: rgba(237, 194, 46, 0.22);
  --accent-strong: #9c7612;
  --tile-2-bg: #eee4da;
  --tile-2-fg: #776e65;
  --tile-4-bg: #ede0c8;
  --tile-4-fg: #776e65;
  --tile-8-bg: #f2b179;
  --tile-8-fg: #fdfbf7;
  --tile-16-bg: #f59563;
  --tile-16-fg: #fdfbf7;
  --tile-32-bg: #f67c5f;
  --tile-32-fg: #fdfbf7;
  --tile-64-bg: #f65e3b;
  --tile-64-fg: #fdfbf7;
  --tile-128-bg: #edcf72;
  --tile-128-fg: #fdfbf7;
  --tile-256-bg: #edcc61;
  --tile-256-fg: #fdfbf7;
  --tile-512-bg: #edc850;
  --tile-512-fg: #fdfbf7;
  --tile-1024-bg: #edc53f;
  --tile-1024-fg: #fdfbf7;
  --tile-2048-bg: #edc22e;
  --tile-2048-fg: #fdfbf7;
  --tile-super-bg: #3c3a32;
  --tile-super-fg: #fdfbf7;
}

