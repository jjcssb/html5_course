/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 20rpx;
  margin: 0;
  border: none;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
  white-space: nowrap;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--primary);
  color: var(--primary-fg);
}

.btn-ghost {
  background: var(--panel-bg);
  color: var(--text);
  border: 1rpx solid var(--panel-border);
}

.btn-danger {
  background: var(--danger);
  color: #fff8f4;
}

.btn-small {
  height: 60rpx;
  font-size: 22rpx;
  padding: 0 16rpx;
}

/* 子页面顶部的“返回游戏合集”入口 */
.page-home-link {
  width: 690rpx;
  height: 48rpx;
  line-height: 48rpx;
  margin-bottom: 6rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}
