.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 30rpx 40rpx;
  padding-bottom: calc(40rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  width: 690rpx;
  margin-top: 10rpx;
}

.header__title {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
}

.header__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-muted);
}

.game-tabs {
  width: 690rpx;
  margin-top: 26rpx;
  display: flex;
  padding: 6rpx;
  border-radius: 18rpx;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
  box-sizing: border-box;
}

.game-tab {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 13rpx;
  font-size: 23rpx;
  color: var(--text-muted);
}

.game-tab--active {
  background: var(--primary);
  color: var(--primary-fg);
  font-weight: 700;
}

.period-tabs {
  width: 690rpx;
  margin-top: 18rpx;
  display: flex;
}

.period-tab {
  height: 56rpx;
  line-height: 56rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--cell-bg);
  color: var(--text-muted);
  font-size: 22rpx;
}

.period-tab--active {
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-weight: 700;
}

.my-card {
  width: 690rpx;
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-radius: 18rpx;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
  box-sizing: border-box;
}

.my-card__label {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
}

.my-card__value {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.my-card__rank {
  flex: 0 0 auto;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.rank-list {
  width: 690rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
}

.rank-row {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 22rpx;
  border-bottom: 1rpx solid var(--panel-border);
  box-sizing: border-box;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-row--me {
  background: var(--accent-soft);
}

.rank-row__rank {
  flex: 0 0 56rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: var(--cell-bg);
  color: var(--text-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.rank-row__rank--1,
.rank-row__rank--2,
.rank-row__rank--3 {
  background: var(--primary);
  color: var(--primary-fg);
}

.rank-row__main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.rank-row__name {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 25rpx;
  font-weight: 600;
}

.rank-row__me {
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--accent-strong);
  color: var(--primary-fg);
  font-size: 17rpx;
}

.rank-avatar {
  flex: 0 0 auto;
  width: 52rpx;
  height: 52rpx;
  margin-left: 8rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  font-size: 28rpx;
  line-height: 52rpx;
  text-align: center;
  overflow: hidden;
}

.rank-avatar__image {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.rank-row__value {
  flex: 0 0 auto;
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.state {
  width: 690rpx;
  min-height: 300rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  box-sizing: border-box;
}

.state__text {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

.state__btn {
  width: 220rpx;
  height: 72rpx;
  margin-top: 22rpx;
  font-size: 24rpx;
}

.footnote {
  width: 690rpx;
  margin-top: 24rpx;
  text-align: center;
  font-size: 19rpx;
  color: var(--text-muted);
}

.load-more {
  width: 690rpx;
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.load-more__btn {
  width: 260rpx;
  height: 72rpx;
  font-size: 23rpx;
}

/* ---------- 排行榜视觉升级 ---------- */
.page {
  background:
    radial-gradient(circle at 10% 0%, rgba(255, 231, 196, 0.55), transparent 34%),
    radial-gradient(circle at 100% 10%, rgba(234, 219, 255, 0.36), transparent 28%),
    var(--bg);
}

.board-hero {
  width: 690rpx;
  margin-top: 10rpx;
  padding: 26rpx 26rpx 30rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #5e4a35 0%, #9a7550 58%, #c59b69 100%);
  box-shadow: 0 20rpx 44rpx rgba(105, 76, 44, 0.22);
  color: #fffaf1;
}

.board-hero__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.board-hero__eyebrow {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  opacity: 0.72;
}

.board-hero__count {
  padding: 7rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 18rpx;
  font-weight: 600;
}

.board-hero__title {
  display: block;
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.board-hero__desc {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  opacity: 0.76;
}

.game-tabs {
  margin-top: 20rpx;
  padding: 6rpx;
  border-radius: 22rpx;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
  box-shadow: 0 8rpx 20rpx rgba(92, 65, 38, 0.05);
}

.game-tab {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.game-tab--active {
  background: linear-gradient(135deg, #8e6a43, #b88954);
  color: #fffaf2;
  box-shadow: 0 6rpx 14rpx rgba(142, 106, 67, 0.22);
}

.period-tabs {
  margin-top: 16rpx;
  gap: 10rpx;
}

.period-tab {
  height: 52rpx;
  line-height: 52rpx;
  margin-right: 10rpx;
  padding: 0 22rpx;
  font-size: 20rpx;
  background: var(--cell-bg);
}

.period-tab--active {
  background: var(--accent-soft);
  color: var(--accent-strong);
  box-shadow: inset 0 0 0 1rpx rgba(155, 116, 70, 0.2);
}

.my-card {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: var(--panel-bg);
  box-shadow: 0 12rpx 26rpx rgba(92, 65, 38, 0.06);
}

.my-card__avatar {
  flex: 0 0 auto;
  width: 62rpx;
  height: 62rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--accent-soft);
  text-align: center;
  line-height: 62rpx;
  font-size: 32rpx;
  overflow: hidden;
}

.my-card__avatar-image {
  width: 62rpx;
  height: 62rpx;
  display: block;
}

.my-card__left {
  flex: 1 1 auto;
  min-width: 0;
}

.my-card__label {
  font-size: 18rpx;
  color: var(--text-muted);
}

.my-card__value {
  margin-top: 3rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.my-card__rank {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  font-size: 20rpx;
}

.podium {
  width: 690rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.podium-card {
  flex: 1 1 0;
  min-width: 0;
  margin-right: 10rpx;
  padding: 18rpx 8rpx 16rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
  box-shadow: 0 10rpx 22rpx rgba(92, 65, 38, 0.06);
  text-align: center;
}

.podium-card:last-child {
  margin-right: 0;
}

.podium-card--1 {
  background: linear-gradient(180deg, #fff2d6, var(--panel-bg));
  border-color: rgba(178, 131, 75, 0.42);
  transform: translateY(-8rpx);
  box-shadow: 0 16rpx 30rpx rgba(145, 104, 54, 0.15);
}

.podium-card--me {
  border-color: var(--accent-strong);
}

.podium-card__medal {
  width: 34rpx;
  height: 34rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--cell-bg);
  color: var(--text-muted);
  font-size: 18rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.podium-card--1 .podium-card__medal {
  background: #d9aa57;
  color: #fffaf1;
}

.podium-card--2 .podium-card__medal {
  background: #d7d2c9;
  color: #fff;
}

.podium-card--3 .podium-card__medal {
  background: #c89b7b;
  color: #fff;
}

.podium-card__avatar {
  width: 70rpx;
  height: 70rpx;
  margin: 12rpx auto 0;
  border-radius: 50%;
  background: var(--accent-soft);
  font-size: 36rpx;
  line-height: 70rpx;
  overflow: hidden;
}

.podium-card__avatar-image {
  width: 70rpx;
  height: 70rpx;
  display: block;
}

.podium-card__name {
  display: block;
  margin-top: 10rpx;
  font-size: 21rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.podium-card__value {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: var(--accent-strong);
  font-weight: 700;
  white-space: nowrap;
}

.rank-list {
  margin-top: 18rpx;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 26rpx rgba(92, 65, 38, 0.05);
}

.rank-row {
  height: 88rpx;
  padding: 0 20rpx;
}

.rank-row__rank {
  flex: 0 0 44rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 10rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.rank-row__name {
  font-size: 23rpx;
  font-weight: 700;
}

.rank-row__value {
  font-size: 22rpx;
}

.rank-list:empty {
  display: none;
}

.footnote {
  margin-top: 18rpx;
  line-height: 1.55;
}

.state--empty {
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: var(--panel-bg);
  border: 1rpx solid var(--panel-border);
}
