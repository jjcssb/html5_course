/* 我的资料：昵称、最佳成绩、成就与云端记录管理 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 30rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-card {
  width: 690rpx;
  margin-top: 8rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  box-shadow: var(--shadow);
}

.avatar {
  flex: 0 0 auto;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--accent-strong);
  color: var(--primary-fg);
  font-size: 48rpx;
  font-weight: 800;
  line-height: 112rpx;
  text-align: center;
  overflow: hidden;
}

.avatar__image {
  width: 112rpx;
  height: 112rpx;
  display: block;
}

.profile-card__main {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 22rpx;
}

.profile-card__label {
  display: block;
  font-size: 20rpx;
  color: var(--text-muted);
}

.nickname-input {
  width: 100%;
  height: 64rpx;
  margin-top: 6rpx;
  padding: 0 4rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
}

.profile-card__hint {
  display: block;
  margin-top: 8rpx;
  font-size: 18rpx;
  line-height: 1.4;
  color: var(--text-muted);
}

.save-row {
  width: 690rpx;
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-end;
}

.save-btn {
  width: 240rpx;
  height: 72rpx;
  font-size: 24rpx;
}

.avatar-grid {
  width: 690rpx;
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
}

.avatar-item {
  width: 98rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 2rpx solid transparent;
  text-align: center;
  line-height: 88rpx;
  box-shadow: var(--shadow);
}

.avatar-item--on {
  border-color: var(--accent-strong);
  background: var(--accent-soft);
}

.avatar-item__emoji {
  font-size: 38rpx;
}

.wechat-avatar-btn {
  width: 690rpx;
  height: 76rpx;
  margin-top: 12rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 2rpx dashed var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.wechat-avatar-btn::after {
  border: none;
}

.wechat-avatar-btn--on {
  border-style: solid;
  border-color: var(--accent-strong);
  background: var(--accent-soft);
}

.wechat-avatar-preview {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
  border-radius: 50%;
}

.wechat-avatar-text {
  font-size: 21rpx;
  color: var(--accent-strong);
  font-weight: 700;
}

.gender-grid {
  width: 690rpx;
  margin-top: 12rpx;
  display: flex;
}

.gender-item {
  flex: 1 1 0;
  height: 76rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  background: var(--card);
  border: 2rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow);
}

.gender-item:last-child {
  margin-right: 0;
}

.gender-item--on {
  border-color: var(--accent-strong);
  background: var(--accent-soft);
}

.gender-item__symbol {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--accent-strong);
}

.gender-item__label {
  margin-left: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.stats {
  width: 690rpx;
  margin-top: 24rpx;
  display: flex;
  justify-content: space-between;
}

.stat {
  flex: 1 1 0;
  min-width: 0;
  margin: 0 6rpx;
  padding: 18rpx 12rpx;
  background: var(--card);
  border-radius: 18rpx;
  box-shadow: var(--shadow);
  text-align: center;
}

.stat:first-child {
  margin-left: 0;
}

.stat:last-child {
  margin-right: 0;
}

.stat__label {
  display: block;
  font-size: 18rpx;
  color: var(--text-muted);
}

.stat__value {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  white-space: nowrap;
}

.section-head {
  width: 690rpx;
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.section-head__title {
  font-size: 26rpx;
  font-weight: 700;
}

.section-head__count {
  font-size: 21rpx;
  color: var(--accent-strong);
  font-weight: 700;
}

.achievement-list {
  width: 690rpx;
  margin-top: 12rpx;
}

.achievement {
  width: 100%;
  margin-bottom: 10rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 18rpx;
  opacity: 0.62;
}

.achievement--on {
  opacity: 1;
  border: 1rpx solid var(--accent-strong);
}

.achievement__dot {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  line-height: 44rpx;
  text-align: center;
  background: var(--accent-soft);
  color: var(--accent-strong);
  font-size: 22rpx;
  font-weight: 700;
}

.achievement__main {
  flex: 1 1 auto;
  min-width: 0;
  margin-left: 14rpx;
}

.achievement__name {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
}

.achievement__desc {
  display: block;
  margin-top: 3rpx;
  font-size: 18rpx;
  color: var(--text-muted);
}

.achievement__state {
  flex: 0 0 auto;
  margin-left: 8rpx;
  font-size: 17rpx;
  color: var(--text-muted);
}

.achievement--on .achievement__state {
  color: var(--accent-strong);
  font-weight: 700;
}

.share-row {
  width: 690rpx;
  margin-top: 18rpx;
  display: flex;
  justify-content: center;
}

.share-btn {
  width: 280rpx;
  height: 76rpx;
  font-size: 24rpx;
}

.danger-row {
  width: 690rpx;
  margin-top: 30rpx;
  text-align: center;
}

.danger-link {
  font-size: 21rpx;
  color: #d64545;
}

.state {
  width: 690rpx;
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

.state--error {
  color: #d64545;
}

.state__text {
  display: block;
}

.state__btn {
  width: 220rpx;
  height: 72rpx;
  margin-top: 22rpx;
  font-size: 23rpx;
}

/* ---------- 资料页视觉升级 ---------- */
.page {
  background:
    radial-gradient(circle at 0% 0%, rgba(255, 228, 188, 0.42), transparent 30%),
    radial-gradient(circle at 100% 6%, rgba(231, 216, 255, 0.24), transparent 26%),
    var(--bg);
}

.profile-card {
  border: 1rpx solid var(--panel-border);
  box-shadow: 0 16rpx 36rpx rgba(92, 65, 38, 0.09);
}

.avatar {
  box-shadow: 0 8rpx 18rpx rgba(92, 65, 38, 0.14);
}

.save-btn {
  width: 100%;
  height: 82rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8e6a43, #b88954);
  color: #fffaf2;
  font-size: 25rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(142, 106, 67, 0.2);
}

.section-head__title {
  font-size: 27rpx;
  letter-spacing: 1rpx;
}

.avatar-item,
.gender-item {
  box-shadow: 0 6rpx 16rpx rgba(92, 65, 38, 0.05);
}

.wechat-avatar-btn {
  height: 82rpx;
  background: var(--accent-soft);
  border-style: solid;
  border-color: rgba(155, 116, 70, 0.28);
}

.wechat-avatar-text {
  font-size: 22rpx;
}

.achievement {
  border: 1rpx solid transparent;
}

.achievement--on {
  box-shadow: 0 8rpx 18rpx rgba(92, 65, 38, 0.06);
}
